# API Keys (set at least one for AI features)
OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=gsk-your-key-here
GEMINI_API_KEY=your-key-here

# Optional: log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Optional: database path override (defaults to ~/.thoth/thoth.db)
THOTH_DB_PATH=

# Optional: AI request timeouts in milliseconds
THOTH_CHAT_TIMEOUT_MS=300000
THOTH_EMBEDDING_TIMEOUT_MS=60000

# Optional: model overrides per provider
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GROQ_CHAT_MODEL=mixtral-8x7b-32768
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
